# AI Agents Dashboard — configuration template.
# The app reads real environment variables; it does NOT auto-load this file.
# Either export these in your shell or set them as Environment= lines in the
# systemd unit (see README.md "Installation").

# Comma-separated Linux users whose agent data (~/.openclaw) is aggregated.
# This is the default agent list for the local server; per-server lists are
# managed from the dashboard's "Manage servers" dialog.
DASHBOARD_USERS=hermes,openclaw

# Deployment mode: 'hub' serves the dashboard UI and pulls from registered
# servers; 'node' is headless (collector + JSON API only, no UI).
DASHBOARD_MODE=hub

# Shared secret a hub presents to read this server's API. REQUIRED in node
# mode. Setting it on a hub also exposes its API, so one hub can be monitored
# by another. Generate with:  openssl rand -hex 32
DASHBOARD_NODE_TOKEN=

# Name this server reports on /api/ping. Defaults to the hostname.
DASHBOARD_NODE_NAME=

# Port to listen on
DASHBOARD_PORT=8080

# Directory for the SQLite database, the persisted session secret, the
# generated password hash, and servers.json (the registry of monitored
# servers — written 0600 because it holds node tokens).
DASHBOARD_DATA_DIR=/var/lib/ai-agents-dashboard

# Candidate model-config filenames per agent, tried in order (comma-separated),
# looked up under agents/<agent>/ and agents/<agent>/agent/
DASHBOARD_MODEL_CONFIG=models.json,profiles.json,model-profiles.json,config.json

# Filesystem whose disk usage is shown. Point it at a host bind mount (e.g.
# /host) when running containerized so the panel reports the server's disk.
DASHBOARD_DISK_PATH=/

# Network interface for throughput. 'auto' picks the first non-loopback
# interface that has received traffic (covers eth0, ens3, enp0s3, wlan0...).
DASHBOARD_NET_IFACE=auto

# SHA-256 hash of the login password (hub mode only). When unset, a random
# password is generated on first start and printed once to the log.
# Generate your own with:  echo -n 'your-password' | sha256sum
DASHBOARD_PASSWORD_HASH=

# Secret for session cookies. Optional: auto-generated and persisted in
# DASHBOARD_DATA_DIR when unset.
DASHBOARD_SECRET=

# Timezone for chart labels and cron times (IANA name)
DASHBOARD_TZ=America/El_Salvador

# Path to the speed-test CLI (optional feature). Leave empty to auto-detect:
# 'speedtest', 'speedtest-ookla', 'speedtest-cli' on PATH, then the usual
# /usr/bin, /usr/local/bin and /snap/bin locations. Both the Ookla CLI and the
# Python speedtest-cli are supported; set this only to force a specific one.
# (The older name SPEEDTEST_BIN still works.)
DASHBOARD_SPEEDTEST_BIN=

# Seconds between speed tests (each run saturates the link for ~20s)
DASHBOARD_SPEEDTEST_COOLDOWN=180
