# Openclaw Server Status Dashboard — configuration template.
# The app reads real environment variables; it does NOT auto-load this file.
# Either export these in your shell or set them as Environment= lines in the
# systemd unit (see README.md "Installation").

# Comma-separated Linux users whose ~/.openclaw data is aggregated
DASHBOARD_USERS=hermes,openclaw

# Port to listen on
DASHBOARD_PORT=8080

# Directory for the SQLite database and persisted session secret
DASHBOARD_DATA_DIR=/var/lib/openclaw-dashboard

# SHA-256 hash of the login password. REQUIRED in production — the in-source
# default is public. Generate with:  echo -n 'your-password' | sha256sum
DASHBOARD_PASSWORD_HASH=

# Secret for session cookies. Optional: auto-generated and persisted in
# DASHBOARD_DATA_DIR when unset.
DASHBOARD_SECRET=

# Timezone for chart labels and cron times (IANA name)
DASHBOARD_TZ=America/El_Salvador

# Path to the Ookla speedtest CLI (optional feature)
SPEEDTEST_BIN=speedtest-ookla
